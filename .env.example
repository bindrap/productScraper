# Email Configuration
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_RECIPIENT=recipient@example.com

# Logging
LOG_LEVEL=info
NODE_ENV=development

# Scraping Settings
HEADLESS_BROWSER=true
BROWSER_TIMEOUT=30000

# Rate Limiting
REQUEST_DELAY=1000
MAX_CONCURRENT_REQUESTS=3