{
  "name": "product-scraper",
  "version": "1.0.0",
  "description": "A flexible web scraper for monitoring product prices and sending email notifications",
  "main": "src/index.js",
  "bin": {
    "product-scraper": "./src/cli.js"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "web": "node src/web/server.js",
    "web:dev": "nodemon src/web/server.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "scrape": "node src/cli.js scrape-all",
    "schedule": "node src/cli.js schedule",
    "setup": "node src/setup.js",
    "validate": "node src/validate.js"
  },
  "keywords": [
    "web-scraping",
    "product-monitoring",
    "price-tracker",
    "email-notifications",
    "automation"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.2",
    "bcrypt": "^5.1.1",
    "better-sqlite3": "^9.2.2",
    "body-parser": "^1.20.2",
    "cheerio": "^1.0.0-rc.12",
    "commander": "^12.0.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-session": "^1.17.3",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.7",
    "puppeteer": "^24.0.0",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "socket.io": "^4.7.2",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.0.2"
  }
}
